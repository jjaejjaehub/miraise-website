# Resend API key (Resend Dashboard → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Verified "From" sender (Resend Dashboard → Domains)
# 도메인 인증 전: onboarding@resend.dev (Resend 계정 이메일로만 발송됨)
RESEND_FROM=onboarding@resend.dev
# RESEND_FROM="miraise <hello@miraise.co>"

# 수신 이메일 (미설정 시 RESEND_FROM 주소로 발송)
# onboarding@resend.dev 사용 시 반드시 Resend에 등록된 계정 이메일로 설정
NOTIFY_EMAIL=you@yourdomain.com

# Optional: reply-to override
# RESEND_REPLY_TO=hello@miraise.co

# Optional: 운영팀 내부 알림 수신 주소 (설정 시 폼 제출마다 추가 알림 발송)
# INBOX_EMAIL=ops@miraise.co

# 로컬 서버 포트 (server/ 에서만 사용, 기본값 3001)
# PORT=3001
